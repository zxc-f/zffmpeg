// Package manifest for the native Zig port; see zig/README.md.
.{
    // Package identity only; it makes no FFmpeg API or ABI compatibility claim.
    .name = .zffmpeg,
    .version = "0.0.0",
    // Generated by the Zig 0.17.0 toolchain (zig build suggested it when the
    // field was missing). Never edit it; a separate fork generates its own.
    .fingerprint = 0x4b4a1226947194f5,
    // A floor recorded as metadata. build.zig enforces the exact tested version.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    // Explicit allowlist: never "" (that would pull in the ignored .references/
    // clones, including the FFmpeg C tree).
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "zig",
        "LICENSE",
        "README.md",
    },
}
